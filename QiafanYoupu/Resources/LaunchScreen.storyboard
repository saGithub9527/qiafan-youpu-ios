                                <constraints>
                                    <constraint firstAttribute="width" constant="196" id="QF-logo-width"/>
                                    <constraint firstAttribute="height" secondItem="QF-launch-logo" secondAttribute="width" multiplier="1:1" id="QF-logo-square"/>
                                </constraints>
